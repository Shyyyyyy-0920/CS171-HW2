#version 410 core

// Bonus: evaluates a Bezier patch at the parameters generated by the tessellator.
//
// The tessellator splits the domain [0, 1] x [0, 1] of every patch into a grid of cells and
// calls this shader once per grid point, with (u, v) = gl_TessCoord.xy. The control points of the patch,
// ordered as `Surface::points`, i.e., P(i, j) = controlPoint[i * (degreeV + 1) + j], are in `controlPoint`.
// Output the position and the unit normal exactly as `TessellateBezier` does on the CPU.
layout(quads, equal_spacing, ccw) in;

in vec3 controlPoint[];

uniform int degreeU;
uniform int degreeV;
uniform mat4 view;
uniform mat4 projection;

out vec3 position;
out vec3 normal;

void main() {
  // TODO: Your code here.
  position = vec3(0.0);
  normal = vec3(0.0);
  gl_Position = vec4(0.0);
}
